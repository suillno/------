# 변수 이름·용도·필수 여부만 기록한다. 실제 값은 넣지 않는다.
# 값은 Git에서 제외한 파일(.env.local, supabase/functions/.env) 또는 서버 비밀 저장소(supabase secrets set)에 둔다.
# 상세 설명: docs/configuration.md
#
# Google Calendar는 사용자 OAuth 토큰으로 등록한다. Google API 키(AIza...)는 쓰지 않으므로 변수가 없다.

# ── 클라이언트 공개 설정 → 저장소 루트 .env.local (web/desktop 번들에 포함됨, RLS 전제) ──
# 필수. Supabase 프로젝트 URL
VITE_SUPABASE_URL=
# 필수. Supabase anon(공개) 키. service-role 키를 넣지 말 것
VITE_SUPABASE_ANON_KEY=
# 필수. development | test | production
VITE_APP_ENV=development

# ── 보관용 값 → 저장소 루트 .env.local (공개 값만, 앱은 읽지 않음) ──
# 선택. 로컬 Supabase와 클라우드를 오갈 때 VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY로 옮겨 쓴다
LOCAL_DEV_SUPABASE_URL=
LOCAL_DEV_SUPABASE_ANON_KEY=
CLOUD_SUPABASE_PROJECT_REF=
CLOUD_SUPABASE_URL=
CLOUD_SUPABASE_ANON_KEY=

# ── 서버 전용 → supabase/functions/.env (로컬) / supabase secrets (운영). 클라이언트·Git·로그 금지 ──
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY는 Edge Function 실행 환경이 자동으로 넣는다.
# 필수(서버). Google OAuth 클라이언트 (Google Cloud 콘솔 > 사용자 인증 정보 > OAuth 클라이언트 ID, 웹 애플리케이션)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 필수(서버). Google 콘솔에 등록한 승인된 리디렉션 URI와 같아야 한다 (…/functions/v1/google-oauth-callback)
GOOGLE_OAUTH_REDIRECT_URI=
# 선택(서버). 공백 구분 scope. 비우면 https://www.googleapis.com/auth/calendar.events.owned
GOOGLE_OAUTH_SCOPES=
# 필수(서버). refresh token 암호화 키. base64로 인코딩한 32바이트 난수
TOKEN_ENCRYPTION_KEY=
# 선택(서버). OAuth 완료 후 돌아갈 웹 앱 origin. 비우면 콜백이 완료 안내 문구를 직접 응답한다(웹 호스팅 없음, 클라우드 기본)
APP_WEB_ORIGIN=
# 선택(서버). Edge Function을 호출할 추가 origin (쉼표 구분, 예: 데스크톱 앱)
APP_ALLOWED_ORIGINS=

# ── 개발/테스트 전용 (운영 빌드에서는 무시됨) ──
# 선택. 로컬 데이터 루트 재정의 (테스트 격리용)
MEETING_ASSISTANT_DATA_ROOT_OVERRIDE=
